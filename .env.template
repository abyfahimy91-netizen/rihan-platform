# =============================================================================
# RIHAN PLATFORM - Environment Variables Template
# =============================================================================
# این فایل را به .env کپی کرده و مقادیر واقعی را جایگزین کنید:
#   cp .env.template .env
# سپس فایل .env را ویرایش کنید. فایل .env در .gitignore است و به مخزن push نمی‌شود.
# =============================================================================

# -----------------------------------------------------------------------------
# Django Core Settings
# -----------------------------------------------------------------------------
# SECRET_KEY: یک رشته تصادفی قوی (حداقل ۵۰ کاراکتر)
# می‌توانید با این دستور تولید کنید:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=CHANGE-ME-GENERATE-A-STRONG-SECRET-KEY-AT-LEAST-50-CHARS

# DEBUG: در production حتماً False باشد
DEBUG=False

# ALLOWED_HOSTS: لیست دامنه‌های مجاز (با کاما جدا کنید)
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,localhost

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# DATABASE_URL: فرمت Django (داخل Docker از نام سرویس db استفاده می‌شود)
DATABASE_URL=postgres://rihan_user:CHANGE_ME_STRONG_PASSWORD@db:5432/rihan_db

# متغیرهای جداگانه برای docker-compose (کانتینر db)
POSTGRES_DB=rihan_db
POSTGRES_USER=rihan_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# -----------------------------------------------------------------------------
# Authentication & SMS (Kavenegar) - ADR-006
# -----------------------------------------------------------------------------
# API Key از پنل کاوه‌نگار: https://panel.kavenegar.com/
KAVENEGAR_API_KEY=your-kavenegar-api-key-here

# -----------------------------------------------------------------------------
# Security Settings
# -----------------------------------------------------------------------------
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True

# -----------------------------------------------------------------------------
# Payment Gateway (MVP: Card-to-Card) - ADR-005
# -----------------------------------------------------------------------------
# اطلاعات حساب مقصد (برای نمایش به مشتری)
CARD_TO_CARD_NUMBER=6037991234567890
CARD_TO_CARD_HOLDER=نام و نام خانوادگی
CARD_TO_CARD_BANK=بانک ملی
RECEIPT_REQUIRED_ABOVE=5000000

# -----------------------------------------------------------------------------
# Feature Flags (Admin Override) - ADR-004
# -----------------------------------------------------------------------------
# این مقادیر پیش‌فرض هستند و از پنل ادمین قابل تغییرند
FEATURE_PWA_ENABLED=True
FEATURE_GUEST_CHECKOUT_ENABLED=True
FEATURE_REVIEW_ENABLED=True

# -----------------------------------------------------------------------------
# Monitoring (Optional)
# -----------------------------------------------------------------------------
# Sentry DSN برای Error Tracking (اختیاری)
SENTRY_DSN=

# -----------------------------------------------------------------------------
# Email (آینده - برای Password Reset و اطلاع‌رسانی)
# -----------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# -----------------------------------------------------------------------------
# Admin
# -----------------------------------------------------------------------------
# اطلاعات superuser اولیه (فقط در اولین اجرا با entrypoint.sh استفاده می‌شود)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PHONE=09120000000
# رمز عبور پشتیبان (ADR-006 v2 - Hybrid Auth)
ADMIN_BACKUP_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
